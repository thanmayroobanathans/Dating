rules_version='2';service cloud.firestore{match/databases/{database}/documents{match/users/{userId}{allow create,read,update,delete:if request.auth!=null&&request.auth.uid==userId;match/results/{resultId}{allow create:if request.auth!=null&&request.auth.uid==userId&&request.resource.data.uid==userId;allow read,update,delete:if request.auth!=null&&request.auth.uid==userId;}}match/aggregateFingerprints/{id}{allow create,update:if request.auth!=null;allow read,delete:if false;}}}
